<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>mvv012.morepipejukenerfs</AssemblyName>
    <AssemblyTitle>More Pipe Juke Nerfs</AssemblyTitle>
    <Version>1.0.0</Version>
    <UpdateModinfoAtPath>../mod/modinfo.json</UpdateModinfoAtPath>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../mod/newest/plugins</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="../lib/**/*.dll" Exclude="../lib/debug/**/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hamunii.BepInEx.AutoPlugin" Version="2.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\RWGenerators\RWGenerators.csproj" PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Debug/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Reference Include="../lib/debug/**/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <UsingTask TaskName="UpdateModinfo" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup />
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
if (!string.IsNullOrEmpty("$(UpdateModinfoAtPath)"))
{
  if (!File.Exists("$(UpdateModinfoAtPath)"))
  {
    Log.LogError("File at $(UpdateModinfoAtPath) doesn't exist");
  }
  else
  {
    string modinfo = File.ReadAllText("$(UpdateModinfoAtPath)");
    string res = modinfo;
    res = Regex.Replace(res, @"(?<=""id"": *"")(.*)(?="")", "$(AssemblyName)");
    res = Regex.Replace(res, @"(?<=""name"": *"")(.*)(?="")", "$(AssemblyTitle)");
    res = Regex.Replace(res, @"(?<=""version"": *"")(.*)(?="")", "$(Version)");

    if (res != modinfo) {
        File.WriteAllText("$(UpdateModinfoAtPath)", res);
        Log.LogWarning("Updated information in $(UpdateModinfoAtPath)");
        Log.LogWarning("Before: " + modinfo);
        Log.LogWarning("After: " + res);
    }
  }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="UpdateModFiles" AfterTargets="PostBuildEvent">
    <UpdateModinfo />
  </Target>

  <Target Name="PackMod" AfterTargets="UpdateModFiles" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <BuildOutputDir>../build/</BuildOutputDir>
    </PropertyGroup>

    <Exec Command="7z a -t7z -mx=7 -bso0 -bsp0 $(BuildOutputDir)/MorePipeJukeNerfs_$(Version).7z ../mod/*" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="SevenZipExitCode"/>
    </Exec>
    <Exec Command="7z a -tzip -mx=7 -bso0 -bsp0 $(BuildOutputDir)/MorePipeJukeNerfs_$(Version).zip ../mod/*" Condition="$(SevenZipExitCode)=='0'"/>

    <ZipDirectory DestinationFile="$(BuildOutputDir)/MorePipeJukeNerfs_$(Version).zip" SourceDirectory="../mod/" Overwrite="true" Condition="$(SevenZipExitCode)!='0'"/>
  </Target>
</Project>
