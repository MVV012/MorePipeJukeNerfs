<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>mvv012.morepipejukenerfs</AssemblyName>
    <AssemblyTitle>More Pipe Juke Nerfs</AssemblyTitle>
    <Version>1.0.2</Version>
    <UpdateModinfoAtPath>../mod/modinfo.json</UpdateModinfoAtPath>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../mod/newest/plugins</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="../lib/**/*.dll" Exclude="../lib/debug/**/*.dll;../lib/gen/**/*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="../lib/debug/**/*.dll" Condition="'$(Configuration)' == 'Debug'">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hamunii.BepInEx.AutoPlugin" Version="2.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Analyzer Include="../lib/gen/RWGenerators.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Debug/**" />
  </ItemGroup>

  <UsingTask TaskName="UpdateModinfo" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup />
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
if (!string.IsNullOrEmpty("$(UpdateModinfoAtPath)"))
{
    if (!File.Exists("$(UpdateModinfoAtPath)"))
    {
        Log.LogError("File at $(UpdateModinfoAtPath) doesn't exist");
    }
    else
    {
        string modinfo = File.ReadAllText("$(UpdateModinfoAtPath)");
        string res = modinfo;
        res = Regex.Replace(res, @"(?<=""id"": *"")(.*)(?="")", "$(AssemblyName)");
        res = Regex.Replace(res, @"(?<=""name"": *"")(.*)(?="")", "$(AssemblyTitle)");
        res = Regex.Replace(res, @"(?<=""version"": *"")(.*)(?="")", "$(Version)");

        if (res != modinfo) {
            File.WriteAllText("$(UpdateModinfoAtPath)", res);
            Log.LogWarning("Updated information in $(UpdateModinfoAtPath)");
            Log.LogWarning("Before: " + modinfo);
            Log.LogWarning("After: " + res);
        }
    }
}
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="UpdateModFiles" AfterTargets="PostBuildEvent">
    <UpdateModinfo />
  </Target>

  <Target Name="PackMod" AfterTargets="UpdateModFiles" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <BuildOutputDir>../build/</BuildOutputDir>
      <ArchiveName>$(AssemblyTitle.Replace(" ", ""))_$(Version)</ArchiveName>
    </PropertyGroup>

    <Exec Command="7z a -t7z -mx=7 -bso0 -bsp0 $(BuildOutputDir)/$(ArchiveName).7z ../mod/*" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="SevenZipExitCode" />
    </Exec>
    <Exec Command="7z a -tzip -mx=7 -bso0 -bsp0 $(BuildOutputDir)/$(ArchiveName).zip ../mod/*" Condition="$(SevenZipExitCode)=='0'" />

    <ZipDirectory DestinationFile="$(BuildOutputDir)/$(ArchiveName).zip" SourceDirectory="../mod/" Overwrite="true" Condition="$(SevenZipExitCode)!='0'" />
  </Target>
</Project>
